# LLM backend for chart abstraction (pick at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Model selection
LLM_BACKEND=anthropic          # anthropic | openai | nvidia | mock

# Anthropic model — pick a currently-live API model ID (not a Claude Code alias)
# Verified working (as of Sep 2026):
#   claude-sonnet-4-5-20250929  (default, best balance of quality + cost)
#   claude-opus-4-1-20250805    (highest quality, ~5x cost)
#   claude-haiku-4-5-20251001   (fastest, cheapest)
# NOT valid via API (Claude Code internal alias): claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_MODEL=gpt-4o
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
