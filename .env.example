# LLM backend for chart abstraction (pick at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Model selection
LLM_BACKEND=anthropic          # anthropic | openai | nvidia | mock
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
